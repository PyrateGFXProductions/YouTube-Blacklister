# Operating System Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Archives and build artifacts
# blacklist-firefox.xpi/.zip/.jar are byte-identical copies of dist/firefox.zip,
# regenerated by package-extension.ps1 — none of them are source.
*.zip
*.tar.gz
*.crx
*.xpi
*.jar
dist/
build/
release/

# Editor and IDE configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# Logs and scratch
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
scratch/
temp/
tmp/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Generated build output — regenerated by `npm run package` (package-extension.ps1).
# These duplicate source files and the derived Firefox manifest, so they drift the
# moment the source changes. Never commit them; never hand-edit them.
/zen-unpacked/
/manifest-firefox.json

# Development scratch — notes, plans, debugging docs and local tool config that a
# user installing the extension has no use for.
/PLAN.md
/.learnings/
/references/
/Generate_icons.html
/.ignore

# Repo-only installers and local agent tooling. These are NOT part of the published
# extension (the packager's $packageFiles never included them) and they are not needed to
# build, test or ship it — so they live in the working tree for local convenience only and
# must not be tracked. install.bat is a Windows "load unpacked" helper for a cloned checkout;
# fix-zen-install.* is the UNVERIFIED Zen enterprise-policy route (ZEN-INSTALL.md Route A,
# AMO signing, is the supported one); .hermes.md is the local agent rules file.
/install.bat
/fix-zen-install.bat
/fix-zen-install.ps1
/.hermes.md
